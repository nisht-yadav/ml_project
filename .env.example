# Environment variables — copy this to .env and fill in values
# Never commit .env to git

# ── General ─────────────────────────────────────────────────
PROJECT_NAME=image_tampering_detection
SEED=42

# ── Paths (override config.yaml if needed) ──────────────────
DATA_ROOT=data
MODELS_DIR=models/saved
LOGS_DIR=logs

# ── Training ────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0    # Set to "" to force CPU

# ── Flask Web App ───────────────────────────────────────────
# Host/port the Flask server binds to. 127.0.0.1 is local-only; WSL2 still
# forwards it to Windows' localhost.
APP_HOST=127.0.0.1
APP_PORT=8501

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=20

# Checkpoint the web app (app/app.py) loads at startup. Relative paths are
# resolved against the project root. See docs/tamper_resnet50_pipeline.md
# §12 for why this specific checkpoint is the recommended default.
# Any TamperResNet50 checkpoint works here; swap in your own weights by changing this path.
# (Also available as: python app/app.py --checkpoint <file>)
MODEL_CHECKPOINT_PATH=models/saved/tamper_resnet50_full_finetune_resumed_b96_best.pth

# JPEG quality used to re-compress images for Error Level Analysis (1-100).
ELA_QUALITY=90

# Block size (pixels) used for block-wise DCT frequency analysis.
DCT_BLOCK_SIZE=8

# JPEG quality every upload is re-saved at during normalization, matching
# what scripts/normalize_dataset.py used to prepare the training dataset
# (see src/inference/normalize.py). Keep this equal to whatever quality
# the checkpoint you're serving was actually trained on.
NORMALIZE_JPEG_QUALITY=90

# Whether to apply EXIF orientation correction during normalization.
# Default matches scripts/normalize_dataset.py's own default (off) so
# uploads go through the identical process the training images did.
FIX_IMAGE_ORIENTATION=false

# Optional: override the checkpoint's own saved inference_threshold for the
# web app's predictions, without retraining. Leave unset to use the
# checkpoint's value as-is.
# INFERENCE_THRESHOLD=0.5
