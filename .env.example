# Environment variables — copy this to .env and fill in values
# Never commit .env to git

# ── General ─────────────────────────────────────────────────
PROJECT_NAME=image_tampering_detection
SEED=42

# ── Paths (override config.yaml if needed) ──────────────────
DATA_ROOT=data
MODELS_DIR=models/saved
LOGS_DIR=logs

# ── Training ────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0    # Set to "" to force CPU

# ── Streamlit App ───────────────────────────────────────────
APP_PORT=8501
